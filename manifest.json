{
  "manifest_version": 3,
  "name": "Video URL Finder",
  "version": "1.0",
  "description": "DevTools panel that lists video URLs on the page with preview and thumbnails",
  "permissions": ["clipboardWrite", "downloads", "tabs", "scripting", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["gestures.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "devtools_page": "devtools.html",
  "icons": {
    "128": "icon.png"
  }
}
